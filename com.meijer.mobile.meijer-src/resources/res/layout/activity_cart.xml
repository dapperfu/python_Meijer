<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_drawer_layout"
    android:tag="layout/activity_cart_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/app_bar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:title="@string/cart"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/ebt_timer_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cart_screen"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ebt_timer_card">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/fulfillment_bar_include"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/fulfillment_divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/fulfillment_divider"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/dividerSize"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/fulfillment_bar_include"
                    style="?attr/dividerFullBleedStyle"/>
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/cart_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toTopOf="@+id/button_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/fulfillment_divider">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:tag="binding_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.compose.ui.platform.ComposeView
                            android:id="@+id/mperks_hvp_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/oos_group"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="out_of_stock_error_callout_view,oos_products_list,oos_textview,remove_all_oos_button"/>
                        <com.meijer.mobile.core.design.widget.calloutview.CalloutView
                            android:id="@+id/out_of_stock_error_callout_view"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_marginHorizontal="16dp"
                            app:body="@string/out_of_stock_item_error_callout_view_body"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintBottom_toTopOf="@+id/oos_textview"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/mperks_hvp_view"
                            app:title="@string/out_of_stock_item_error_callout_view_title"
                            style="?attr/calloutErrorStyle"/>
                        <TextView
                            android:textAppearance="?attr/textAppearanceBody1"
                            android:id="@+id/oos_textview"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:text="@string/out_of_stock_no_stock"
                            app:layout_constraintBottom_toTopOf="@+id/oos_products_list"
                            app:layout_constraintEnd_toStartOf="@+id/remove_all_oos_button"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/out_of_stock_error_callout_view"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remove_all_oos_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/out_of_stock_remove_items"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintBottom_toTopOf="@+id/oos_products_list"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/out_of_stock_error_callout_view"
                            style="?attr/borderlessButtonStyle"/>
                        <View
                            android:id="@+id/bottom_calloutDivider"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="2dp"
                            app:layout_constraintBottom_toTopOf="@+id/oos_products_list"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/oos_textview"
                            style="?attr/dividerFullBleedStyle"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/oos_products_list"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:overScrollMode="never"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintBottom_toTopOf="@+id/add_items_button"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/remove_all_oos_button"
                            app:layout_constraintVertical_bias="0"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/add_items_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginRight="16dp"
                            android:text="@string/add_more_items"
                            android:layout_marginHorizontal="16dp"
                            app:layout_constraintBottom_toTopOf="@+id/alcohol_restriction_warning"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/oos_products_list"
                            style="?attr/materialButtonOutlinedStyleLarge"/>
                        <include
                            android:id="@+id/alcohol_restriction_warning"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_marginHorizontal="16dp"
                            app:layout_constraintBottom_toTopOf="@+id/order_summary_include"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/add_items_button"
                            layout="@layout/alcohol_restriction_message"/>
                        <include
                            android:id="@+id/order_summary_include"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintBottom_toTopOf="@+id/eligible_for_delivery_section"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/alcohol_restriction_warning"
                            layout="@layout/cart_order_summary"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/eligible_for_delivery_section"
                            android:background="?attr/colorSurface"
                            android:paddingLeft="16dp"
                            android:paddingTop="16dp"
                            android:paddingRight="16dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            app:layout_constraintBottom_toTopOf="@+id/item_count_empty_cart_section"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/order_summary_include">
                            <TextView
                                android:textAppearance="?attr/textAppearanceHeadline6"
                                android:paddingBottom="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/eligible_for_delivery_title"/>
                            <TextView
                                android:textAppearance="?attr/textAppearanceBody1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/eligible_for_delivery_message"/>
                        </LinearLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/item_count_empty_cart_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toTopOf="@+id/product_list_divider"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/order_summary_include">
                            <com.google.android.material.textview.MaterialTextView
                                android:textAppearance="?attr/textAppearanceBody1"
                                android:textColor="?android:attr/textColorPrimary"
                                android:id="@+id/cart_item_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:layout_marginStart="16dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <com.google.android.material.button.MaterialButton
                                android:textSize="16sp"
                                android:id="@+id/empty_cart_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/empty_cart"
                                android:layout_marginEnd="16dp"
                                app:layout_constraintBaseline_toBaselineOf="@+id/cart_item_count"
                                app:layout_constraintEnd_toEndOf="parent"
                                style="?attr/borderlessButtonStyle"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <View
                            android:id="@+id/product_list_divider"
                            android:layout_width="0dp"
                            android:layout_height="?attr/dividerSize"
                            app:layout_constraintBottom_toTopOf="@+id/products_list"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/item_count_empty_cart_section"
                            style="?attr/dividerFullBleedStyle"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/products_list"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:overScrollMode="never"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/product_list_divider"/>
                        <androidx.compose.ui.platform.ComposeView
                            android:id="@+id/google_ads_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/products_list"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/need_help_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/need_help"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/google_ads_bottom"
                            style="?attr/borderlessButtonStyle"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textColor="?android:attr/textColorPrimary"
                            android:gravity="center"
                            android:id="@+id/cart_id"
                            android:paddingBottom="16dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/need_help_button"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.core.widget.NestedScrollView>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/compose_toast_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/button_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_container"
                    android:background="?attr/colorSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cart_view">
                    <View
                        android:id="@+id/checkout_divider"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/dividerSize"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="?attr/dividerFullBleedStyle"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkout_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="?attr/materialButtonStyleLarge"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancel_update_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/cancel_update"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/update_order_button"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="?attr/materialButtonSecondaryStyleLarge"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/update_order_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/update_order"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cancel_update_button"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="?attr/materialButtonStyleLarge"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/update_button_group"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="cancel_update_button,update_order_button"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/error_empty_screen_include"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/cart_error_empty_screen"/>
            <com.meijer.mobile.ui.legacy.progressview.ProgressView
                android:id="@+id/progress_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:view_dim_alpha="0.4"
                app:view_to_dim="@+id/cart_screen"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <include layout="@layout/navigation_view_default"/>
</androidx.drawerlayout.widget.DrawerLayout>
