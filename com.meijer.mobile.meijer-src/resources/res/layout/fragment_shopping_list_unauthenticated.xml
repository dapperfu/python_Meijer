<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_shopping_list_unauthenticated_0"
    android:background="@color/legacy_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/unauth_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.meijer.mobile.widget.UnauthContentView
                android:id="@+id/shop_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawable="0x7f0806b7"
                app:desc="@string/shop_desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:title="@string/shop_title"/>
            <ImageView
                android:id="@+id/shopping_list_splash_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:src="0x7f0801ba"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shop_view"/>
            <com.meijer.mobile.widget.UnauthContentView
                android:id="@+id/create_list_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawable="0x7f080230"
                app:desc="@string/create_a_list_desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shopping_list_splash_image"
                app:title="@string/create_a_list_title"/>
            <com.meijer.mobile.widget.UnauthContentView
                android:id="@+id/save_favorites_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawable="0x7f0805fa"
                app:desc="@string/save_fav_desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/create_list_view"
                app:title="@string/save_fav_title"/>
            <com.meijer.mobile.widget.UnauthContentView
                android:id="@+id/search_scan_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:drawable="0x7f0806a9"
                app:desc="@string/search_items_scan_desc"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/save_favorites_view"
                app:title="@string/search_items_scan_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.meijer.mobile.widget.UnauthFooterView
        android:id="@+id/unauth_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/drop_shadow"
        android:background="@drawable/inverse_dropshadow"
        android:layout_width="0dp"
        android:layout_height="@dimen/unauth_footer_shadow_height"
        app:layout_constraintBottom_toTopOf="@+id/unauth_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
