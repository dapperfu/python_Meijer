<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_choking_warning"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/choking_warning_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_choking_yellow_warning"
        android:contentDescription="@string/age_restriction_and_choking_hazard_warning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MeijerDDS.Gray.Semibold"
        android:textSize="14sp"
        android:id="@+id/choking_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/choking_warning"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/choking_text"
        app:layout_constraintLeft_toRightOf="@+id/choking_warning_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MeijerDDS.Gray"
        android:textSize="14sp"
        android:id="@+id/choking_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/choking_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/choking_warning"
        app:layout_constraintTop_toBottomOf="@+id/choking_warning"/>
</androidx.constraintlayout.widget.ConstraintLayout>
