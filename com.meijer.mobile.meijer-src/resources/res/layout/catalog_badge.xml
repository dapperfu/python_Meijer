<?xml version="1.0" encoding="utf-8"?>
<com.meijer.mobile.core.design.widget.cards.ExpandableCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:title="Badge">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/badgeTextColorBlue"
            android:id="@+id/badge_new"
            android:background="@drawable/badge_hat_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_new"
            style="?attr/textViewStyleBadge"/>
        <TextView
            android:textColor="?attr/badgeTextColorYellow"
            android:id="@+id/badge_expiring_soon"
            android:background="@drawable/badge_hat_yellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_expiring_soon"
            android:layout_marginStart="16dp"
            style="?attr/textViewStyleBadge"/>
        <TextView
            android:textColor="?attr/badgeTextColorGreen"
            android:id="@+id/badge_price_to_go"
            android:background="@drawable/badge_hat_green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/price_to_go"
            android:layout_marginStart="16dp"
            style="?attr/textViewStyleBadge"/>
    </LinearLayout>
</com.meijer.mobile.core.design.widget.cards.ExpandableCardView>
