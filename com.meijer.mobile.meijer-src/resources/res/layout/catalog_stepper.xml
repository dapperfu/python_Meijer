<?xml version="1.0" encoding="utf-8"?>
<com.meijer.mobile.core.design.widget.cards.ExpandableCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:title="Quantity Steppers">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.meijer.mobile.core.design.widget.stepperview.CollapsibleStepperView
            android:id="@+id/stepper_view"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            app:layout_constraintBottom_toTopOf="@+id/stepper_extended"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.MeijerDDS.Stepper.InList"/>
        <com.meijer.mobile.core.design.widget.stepperview.StepperView
            android:id="@+id/stepper_extended"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            app:addButtonText="Add to Cart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stepper_view"
            style="@style/Widget.MeijerDDS.Stepper.InDetail"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.meijer.mobile.core.design.widget.cards.ExpandableCardView>
