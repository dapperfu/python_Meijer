<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cart_list_item_container"
    android:tag="layout/view_cart_list_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/cart_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintStart_toEndOf="@+id/start_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/product_image"
            android:layout_marginTop="@dimen/activity_padding_vertical"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/substitution_item"
            app:layout_constraintEnd_toStartOf="@+id/product_name"
            app:layout_constraintStart_toStartOf="@+id/start_line"
            app:layout_constraintTop_toBottomOf="@+id/cart_tags"
            app:layout_constraintVertical_bias="0"
            style="@style/Widget.MeijerDDS.ImageView.Thumbnail"/>
        <com.meijer.mobile.core.base.ui.textview.FullWordEllipsisTextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:id="@+id/product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/activity_padding_horizontal"
            android:layout_marginRight="@dimen/activity_padding_horizontal"
            android:maxLines="2"
            android:labelFor="@+id/stepper_view"
            android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/product_price"
            app:layout_constraintEnd_toStartOf="@+id/ellipsis_action_button"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toTopOf="@+id/product_image"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?android:attr/textColorSecondary"
            android:id="@+id/product_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="@dimen/activity_padding_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/product_saved_price"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/product_name"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceBody2"
            android:id="@+id/product_saved_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="@dimen/activity_padding_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/product_total_price"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/product_price"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceHeadline6B"
            android:id="@+id/product_total_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="@dimen/activity_padding_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/final_cost_by_weight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/product_saved_price"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?android:attr/textColorSecondary"
            android:id="@+id/final_cost_by_weight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/final_cost_by_weight"
            android:layout_marginStart="@dimen/activity_padding_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/product_see_savings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/product_total_price"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorPrimary"
            android:id="@+id/product_see_savings"
            android:background="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_dds_see_savings"
            android:layout_marginStart="@dimen/activity_padding_horizontal"
            android:layout_marginVertical="8dp"
            app:layout_constraintBottom_toTopOf="@+id/product_add_backup"
            app:layout_constraintEnd_toEndOf="@+id/product_name"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/final_cost_by_weight"
            style="?attr/textViewStyleSubtitle2"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/product_add_backup"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_backup"
            app:layout_constraintBottom_toTopOf="@+id/product_add_backup"
            app:layout_constraintStart_toStartOf="@+id/product_total_price"
            app:layout_constraintTop_toBottomOf="@+id/product_see_savings"
            style="?attr/borderlessButtonStyle"/>
        <include
            android:id="@+id/substitution_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/item_note_section"
            app:layout_constraintEnd_toEndOf="@+id/end_line"
            app:layout_constraintStart_toStartOf="@+id/start_line"
            app:layout_constraintTop_toBottomOf="@+id/product_add_backup"
            layout="@layout/view_cart_item_note"/>
        <include
            android:id="@+id/item_note_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
            app:layout_constraintEnd_toEndOf="@+id/end_line"
            app:layout_constraintStart_toStartOf="@+id/start_line"
            app:layout_constraintTop_toBottomOf="@+id/substitution_item"
            layout="@layout/view_cart_item_note"/>
        <ImageButton
            android:id="@+id/ellipsis_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/product_ellipsis_button_content_description"
            app:layout_constraintEnd_toEndOf="@+id/end_line"
            app:layout_constraintStart_toEndOf="@+id/product_name"
            app:layout_constraintTop_toBottomOf="@+id/cart_tags"
            app:layout_constraintVertical_bias="0"
            app:srcCompat="@drawable/ic_dds_more_horizontal"
            app:tint="?attr/colorPrimary"/>
        <FrameLayout
            android:id="@+id/cell_mask"
            android:background="?attr/colorSurface"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/product_removed_from_cart_btn"
            android:alpha="0.5"
            app:icon="@drawable/ic_dds_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.meijer.mobile.core.design.widget.stepperview.CollapsibleStepperView
            android:id="@+id/stepper_view"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            app:layout_constraintBottom_toTopOf="@+id/substitution_item"
            app:layout_constraintEnd_toEndOf="@+id/end_line"
            app:layout_constraintTop_toBottomOf="@+id/ellipsis_action_button"
            app:layout_constraintVertical_bias="0.5"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/note_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="stepper_view,product_total_price,product_image,product_add_backup"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/top_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/activity_padding_horizontal"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/bottom_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/activity_padding_horizontal"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/start_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/activity_padding_horizontal"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/end_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/activity_padding_horizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
