<?xml version="1.0" encoding="utf-8"?>
<com.meijer.mobile.core.design.widget.cards.ExpandableCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:title="Typography">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline1"
            android:id="@+id/h1"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Headlines XL H1"/>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline2"
            android:id="@+id/h2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titles/Headlines Lg H2"/>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline3"
            android:id="@+id/h3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titles/Headlines Med H3"/>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline4"
            android:id="@+id/h4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titles/Headlines H4"/>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:id="@+id/h5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titles/Headlines H5"/>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:id="@+id/h6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titles/Headlines H6"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:id="@+id/subtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtitle 1"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:id="@+id/subtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtitle 2"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody1"
            android:id="@+id/body1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Body 1"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2"
            android:id="@+id/body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Body 2"/>
        <TextView
            android:textAppearance="?attr/textAppearanceButton"
            android:id="@+id/buttonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Button"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaption"
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Caption"/>
        <TextView
            android:textAppearance="?attr/textAppearanceOverline"
            android:id="@+id/overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overline"/>
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            style="?attr/textViewStyleCircle"/>
        <TextView
            android:id="@+id/coupon_status_clipped"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clipped!"
            style="?attr/textViewStyleClippedCoupon"/>
        <TextView
            android:id="@+id/coupon_status_unclipped"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clip"
            style="?attr/textViewStyleClipCoupon"/>
    </LinearLayout>
</com.meijer.mobile.core.design.widget.cards.ExpandableCardView>
