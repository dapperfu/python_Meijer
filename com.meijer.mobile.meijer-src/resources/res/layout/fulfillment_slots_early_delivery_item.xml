<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fulfillment_slots_early_delivery_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="?attr/dividerSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/dividerFullBleedStyle"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/early_delivery_checkbox"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/early_delivery_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/fulfillment_slot_early_delivery_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/early_delivery_checkbox"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextAppearance.MeijerDDS.Headline6.5"/>
    <TextView
        android:id="@+id/early_delivery_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fulfillment_slot_early_delivery_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/early_delivery_checkbox"
        app:layout_constraintTop_toBottomOf="@+id/early_delivery_header"
        style="?attr/textViewStyleBody1"/>
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="?attr/dividerSize"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/early_delivery_description"
        style="?attr/dividerFullBleedStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
