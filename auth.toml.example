# Meijer Registration Configuration Example
# Generated by Meijer CLI
# 
# Usage:
# 1. Copy this file to auth.toml
# 2. Edit the values as needed
# 3. Run: meijer auth register --config auth.toml
#
# Note: Remove or comment out the password field for security
# The CLI will prompt for the password during registration

[registration]
# Personal Information
first_name = "John"
last_name = "Doe"
email = "john.doe@example.com"
phone = "5551234567"
password = "your_secure_password_here"  # Remove this line for security
zip_code = "12345"

# Optional Settings
store_id = ""  # Leave empty for auto-detection
accept_terms = true
marketing_opt_in = false

# Metadata
created_at = "2025-08-26T12:00:00"
notes = "Example configuration - Edit before using"
