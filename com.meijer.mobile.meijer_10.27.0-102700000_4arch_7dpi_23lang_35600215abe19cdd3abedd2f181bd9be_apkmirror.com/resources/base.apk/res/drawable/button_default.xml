<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/legacy_blue"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/legacy_blue"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="@color/legacy_blue_soft"/>
            <solid android:color="@color/legacy_white"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="@color/legacy_blue"/>
            <solid android:color="@color/legacy_white"/>
        </shape>
    </item>
</selector>
