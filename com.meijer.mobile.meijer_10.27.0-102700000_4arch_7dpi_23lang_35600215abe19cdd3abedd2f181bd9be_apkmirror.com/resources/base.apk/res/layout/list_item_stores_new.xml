<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/list_item_stores_new_0"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/list_item_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/count_in_list"
            android:background="@drawable/ic_location_red"
            android:paddingBottom="3dp"
            android:layout_width="16dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/store_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Meijer.Widget.TextView.Small.White_bold"/>
        <TextView
            android:textSize="@dimen/text_size_shopping_list_default"
            android:ellipsize="end"
            android:id="@+id/store_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/store_address"
            app:layout_constraintEnd_toStartOf="@+id/store_distance"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/count_in_list"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="?attr/textViewStyleCardHeading1"/>
        <TextView
            android:textSize="@dimen/text_size_shopping_list_small"
            android:id="@+id/store_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toTopOf="@+id/store_city_state_zip"
            app:layout_constraintEnd_toStartOf="@+id/store_distance"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="@+id/store_name"
            app:layout_constraintTop_toBottomOf="@+id/store_name"
            style="?attr/textViewStyleCardBody2"/>
        <TextView
            android:textSize="@dimen/text_size_shopping_list_small"
            android:id="@+id/store_city_state_zip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toTopOf="@+id/store_hours"
            app:layout_constraintEnd_toStartOf="@+id/store_distance"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="@+id/store_name"
            app:layout_constraintTop_toBottomOf="@+id/store_address"
            style="?attr/textViewStyleCardBody2"/>
        <TextView
            android:textSize="@dimen/text_size_shopping_list_small"
            android:id="@+id/store_hours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/store_distance"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="@+id/store_name"
            app:layout_constraintTop_toBottomOf="@+id/store_address"
            style="?attr/textViewStyleCardBody2"/>
        <TextView
            android:textSize="@dimen/text_size_shopping_list_default"
            android:textColor="@color/black"
            android:id="@+id/store_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/store_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/store_name"
            style="?attr/textViewStyleCardHeading1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
