<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_drawer_layout"
    android:tag="layout/activity_coupon_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/tool_bar_elevation">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/app_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="0dp"
                app:layout_scrollFlags="enterAlways|scroll"
                app:navigationIcon="?attr/homeAsUpIndicator"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/searchbar_container"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <TextView
                    android:textColor="?attr/couponSearchBarColor"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/search"
                    android:background="@drawable/round_button_white_small_radius"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/coupon_search_bar_hint"
                    android:maxLines="1"
                    android:paddingStart="?attr/actionBarSize"
                    android:paddingEnd="?attr/actionBarSize"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="?attr/textViewStyleBody1"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/search_icon"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginStart="2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/search"
                    app:srcCompat="@drawable/ic_dds_search"
                    app:tint="?attr/couponSearchBarColor"/>
                <ImageButton
                    android:id="@+id/scanner_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:contentDescription="@string/barcode_button"
                    app:layout_constraintBottom_toBottomOf="@+id/search"
                    app:layout_constraintEnd_toEndOf="@+id/search"
                    app:layout_constraintTop_toTopOf="@+id/search"
                    app:srcCompat="@drawable/ic_dds_barcode"
                    app:tint="?attr/colorControlPrimary"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/coupon_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Meijer.Widget.TabLayout"/>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scrolling_content"
            android:background="?android:attr/colorBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <com.meijer.mobile.widget.SwipeViewPager
                android:id="@+id/coupon_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:swipeEnabled="false"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <include layout="@layout/navigation_view_default"/>
</androidx.drawerlayout.widget.DrawerLayout>
