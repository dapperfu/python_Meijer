<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/time_slots_read_only_section_container"
    android:tag="layout/time_slots_read_only_section_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textSize="16sp"
        android:id="@+id/am_times_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/morning_time_slots_section_title"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/am_times_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/am_times_label"/>
    <include
        android:id="@+id/am_times_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/am_times_count"
        layout="@layout/view_divider_gray"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/am_times_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/am_times_label"
        app:layout_constraintTop_toBottomOf="@+id/am_times_divider"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/am_times_empty_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/afternoon_time_slots_section_title"
        app:layout_constraintEnd_toEndOf="@+id/am_times_count"
        app:layout_constraintStart_toStartOf="@+id/am_times_label"
        app:layout_constraintTop_toBottomOf="@+id/am_times_list"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textSize="16sp"
        android:id="@+id/pm_times_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/afternoon_time_slots_section_title"
        app:layout_constraintStart_toStartOf="@+id/am_times_label"
        app:layout_constraintTop_toBottomOf="@+id/am_times_empty_tv"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/pm_times_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/am_times_count"
        app:layout_constraintTop_toTopOf="@+id/pm_times_label"/>
    <include
        android:id="@+id/read_only_time_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pm_times_count"
        layout="@layout/view_divider_gray"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pm_times_list"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/pm_times_label"
        app:layout_constraintTop_toBottomOf="@+id/read_only_time_divider"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/pm_times_empty_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/afternoon_time_slots_section_title"
        app:layout_constraintEnd_toEndOf="@+id/pm_times_count"
        app:layout_constraintStart_toStartOf="@+id/pm_times_label"
        app:layout_constraintTop_toBottomOf="@+id/pm_times_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
