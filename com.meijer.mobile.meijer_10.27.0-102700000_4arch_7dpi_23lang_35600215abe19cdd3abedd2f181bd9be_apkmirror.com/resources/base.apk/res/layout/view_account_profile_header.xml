<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_header_container"
    android:tag="layout/view_account_profile_header_0"
    android:background="@drawable/background_primary_gradient"
    android:layout_width="match_parent"
    android:layout_height="150dp">
    <TextView
        android:textAppearance="@style/TextAppearance.MeijerDDS.Headline5.SemiBold"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/profile_header_user_greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="@+id/profile_header_edit_icon"
        app:layout_constraintHorizontal_bias="0.045"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/profile_header_edit_icon"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:src="@drawable/ic_dds_pencil"
        android:contentDescription="@string/settings_account"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnPrimary"/>
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/profile_header_user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/profile_header_user_greeting"
        app:layout_constraintTop_toBottomOf="@+id/profile_header_user_greeting"/>
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/profile_header_user_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/profile_header_user_greeting"
        app:layout_constraintTop_toBottomOf="@+id/profile_header_user_email"/>
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/profile_header_home_store"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/profile_header_user_greeting"
        app:layout_constraintTop_toBottomOf="@+id/profile_header_user_phone"/>
</androidx.constraintlayout.widget.ConstraintLayout>
