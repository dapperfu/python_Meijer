<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_shopping_list_item_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1px"
    android:layout_marginBottom="1px"
    android:elevation="0dp"
    android:layout_marginVertical="1px"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.meijer.mobile.meijer.activity.shoppinglist.view.ShoppingListItemCheckBox
            android:id="@+id/item_complete_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/shopping_list_item_complete"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/item_description"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            style="@style/Meijer.Widget.CheckBox.ShoppingList"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/item_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:text="@null"
            android:singleLine="true"
            android:layout_marginEnd="8dp"
            android:labelFor="@+id/item_complete_checkbox"
            app:layout_constrainedWidth="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/item_complete_checkbox"
            app:layout_constraintBottom_toTopOf="@+id/item_notes"
            app:layout_constraintEnd_toStartOf="@+id/item_link_image"
            app:layout_constraintStart_toEndOf="@+id/item_complete_checkbox"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            style="?attr/textViewStyleBody1"/>
        <ImageButton
            android:id="@+id/item_link_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/coupon"
            app:layout_constraintBottom_toBottomOf="@+id/item_complete_checkbox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_description"
            app:layout_constraintTop_toTopOf="@+id/item_complete_checkbox"
            app:layout_constraintVertical_bias="0"
            app:tint="?attr/colorControlPrimary"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:attr/textColorTertiary"
            android:ellipsize="end"
            android:id="@+id/item_notes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/item_description"
            app:layout_constraintStart_toStartOf="@+id/item_description"
            app:layout_constraintTop_toBottomOf="@+id/item_description"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
