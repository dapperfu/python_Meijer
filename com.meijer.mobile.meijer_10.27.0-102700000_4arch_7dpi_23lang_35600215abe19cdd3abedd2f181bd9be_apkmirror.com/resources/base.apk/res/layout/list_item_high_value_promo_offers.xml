<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_item_high_value_promo_offer_cl"
    android:tag="layout/list_item_high_value_promo_offers_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/high_value_promo_offer_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/terms_checkbox_start_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/high_value_promo_offer_title_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/high_value_promo_offer_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/high_value_promo_offer_exp_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/high_value_promo_offer_checkbox"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="16dp"
        style="?attr/textViewStyleTitle1"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/high_value_promo_offer_exp_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/high_value_promo_offer_checkbox"
        app:layout_constraintTop_toBottomOf="@+id/high_value_promo_offer_title_tv"
        style="?attr/textViewStyleBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
