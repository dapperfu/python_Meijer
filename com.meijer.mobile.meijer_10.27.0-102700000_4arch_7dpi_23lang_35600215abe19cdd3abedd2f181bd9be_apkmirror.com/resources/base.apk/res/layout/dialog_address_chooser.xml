<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_address_chooser_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_rectangle_rounded"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="280dp">
        <TextView
            android:textAppearance="@style/TextAppearance.MeijerDDS.Headline6"
            android:id="@+id/dialog_title"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/address_dialog_title"
            android:singleLine="false"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:labelFor="@+id/your_address"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_percent="0.87"/>
        <TextView
            android:id="@+id/suggested_address_title"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/address_dialog_suggested"
            android:layout_marginEnd="24dp"
            android:labelFor="@+id/suggested_address"
            app:layout_constraintStart_toStartOf="@+id/dialog_title"
            app:layout_constraintTop_toBottomOf="@+id/dialog_title"
            style="?attr/textViewStyleBody1"/>
        <TextView
            android:id="@+id/suggested_address"
            android:tag="binding_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/dialog_title"
            app:layout_constraintTop_toBottomOf="@+id/suggested_address_title"
            style="?attr/textViewStyleBody1"/>
        <TextView
            android:id="@+id/original_address_title"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/address_dialog_original"
            android:layout_marginEnd="24dp"
            android:labelFor="@+id/suggested_address"
            app:layout_constraintStart_toStartOf="@+id/dialog_title"
            app:layout_constraintTop_toBottomOf="@+id/suggested_address"
            style="?attr/textViewStyleBody1"/>
        <TextView
            android:id="@+id/your_address"
            android:tag="binding_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/dialog_title"
            app:layout_constraintTop_toBottomOf="@+id/original_address_title"
            style="?attr/textViewStyleBody1"/>
        <Button
            android:id="@+id/use_suggested_address_button"
            android:tag="binding_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/address_dialog_use_suggested"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/your_address"
            style="?attr/borderlessButtonStyle"/>
        <Button
            android:id="@+id/use_my_address_button"
            android:tag="binding_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/address_dialog_use_original"
            app:layout_constraintEnd_toEndOf="@+id/use_suggested_address_button"
            app:layout_constraintTop_toBottomOf="@+id/use_suggested_address_button"
            style="?attr/borderlessButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
