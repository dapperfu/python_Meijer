<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/autocomplete_message_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Gmp.Sys.Typescale.BodyMedium"
        android:textColor="?attr/placesColorOnSurface"
        android:id="@+id/autocomplete_message_text_view"
        android:paddingTop="@dimen/gmp_sys_measurement_spacing_medium"
        android:paddingBottom="@dimen/gmp_sys_measurement_spacing_medium"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/autocomplete_no_matching_results_for_query"
        android:layout_weight="1"
        android:paddingStart="@dimen/gmp_sys_measurement_spacing_large"
        android:paddingEnd="@dimen/gmp_sys_measurement_spacing_large"/>
    <View
        android:background="?attr/placesColorOutlineDecorative"
        android:layout_width="match_parent"
        android:layout_height="@dimen/place_widget_border_width"/>
</LinearLayout>
