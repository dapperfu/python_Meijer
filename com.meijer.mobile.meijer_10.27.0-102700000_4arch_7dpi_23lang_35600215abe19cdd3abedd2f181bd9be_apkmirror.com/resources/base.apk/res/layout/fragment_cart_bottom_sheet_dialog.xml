<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cart_bottom_sheet"
    android:tag="layout/fragment_cart_bottom_sheet_dialog_0"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TableLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TableRow
            android:id="@+id/remove_section"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/remove_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:src="@drawable/ic_dds_delete"
                android:importantForAccessibility="no"
                app:tint="?attr/colorControlPrimary"/>
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="?attr/textAppearanceBody1"
                android:layout_gravity="center_vertical"
                android:id="@+id/remove_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remove_from_cart"/>
        </TableRow>
        <TableRow
            android:id="@+id/add_note_section"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/add_note_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:src="@drawable/ic_dds_pencil"
                android:importantForAccessibility="no"
                app:tint="?attr/colorPrimary"/>
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="?attr/textAppearanceBody1"
                android:layout_gravity="center_vertical"
                android:id="@+id/add_note_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_note"/>
        </TableRow>
        <TableRow
            android:id="@+id/cancel_section"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/cancel_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:src="@drawable/ic_dds_close_lg"
                android:importantForAccessibility="no"
                app:tint="?attr/colorPrimary"/>
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="?attr/textAppearanceBody1"
                android:layout_gravity="center_vertical"
                android:id="@+id/cancel_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"/>
        </TableRow>
    </TableLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
