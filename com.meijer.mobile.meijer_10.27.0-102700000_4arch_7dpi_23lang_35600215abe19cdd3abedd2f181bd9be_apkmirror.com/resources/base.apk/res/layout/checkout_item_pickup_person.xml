<?xml version="1.0" encoding="utf-8"?>
<com.meijer.mobile.core.design.widget.calloutview.ListCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickup_person_card"
    android:tag="layout/checkout_item_pickup_person_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:actionButtonText="@string/edit_checkout_requirement"
    app:icon="@drawable/ic_dds_account"
    app:title="@string/order_summary_label_pickup_person">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/pickup_person_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textViewStyleBody1"/>
        <TextView
            android:id="@+id/pickup_person_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textViewStyleBody1"/>
        <TextView
            android:id="@+id/pickup_person_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textViewStyleBody1"/>
        <TextView
            android:id="@+id/pickup_vehicle_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textViewStyleBody1"/>
        <TextView
            android:id="@+id/pickup_person_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textViewStyleError"/>
    </LinearLayout>
</com.meijer.mobile.core.design.widget.calloutview.ListCardView>
