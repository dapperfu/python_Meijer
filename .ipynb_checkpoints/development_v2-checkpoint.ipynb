     "text": [
      "200 {\"conflictType\":1,\"name\":\"NoConflict\"}\n"
     ]
    }
   ],
   "source": [
    "url = f\"https://api.meijer.com/loyalty/accounts/getConflictTypeByPhone/{phone_number}\"\n",
    "headers = {\n",
    "    \"accept\": \"application/vnd.meijer.account.phoneNumberConflictStatus-v1.0+json\",\n",
    "    \"content-type\": \"application/json\",\n",
