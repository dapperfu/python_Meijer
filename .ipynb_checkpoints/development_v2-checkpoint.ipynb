    "    \"accept-encoding\": \"gzip\",\n",
    "}\n",
    "\n",
    "session = requests.Session()\n",
    "\n",
    "response = session.get(url, headers=headers)\n",
    "\n",
    "print(response.status_code, response.text)"
   ]
  },
