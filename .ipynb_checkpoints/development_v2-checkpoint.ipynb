   "source": [
    "# List of common Michigan area codes\n",
    "michigan_area_codes = [\"248\", \"313\", \"517\", \"586\", \"616\", \"734\", \"810\", \"906\", \"947\"]\n",
    "\n",
    "# Generate a fake phone number with a Michigan area code\n",
    "area_code = random.choice(michigan_area_codes)\n",
    "phone_number = f\"{area_code}{random.randint(100,999)}{random.randint(1000,9999)}\"  # Ensures a 10-digit number"
   ]
  },
  {
   "cell_type": "code",
