    "class MeijerSession(requests.Session):\n",
    "    BASE_URL = \"https://api.meijer.com\"\n",
    "    API_KEY = \"a10bc58ac484478d9b3958b1742c3a03\"  # This should ideally be stored securely\n",
    "    \n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.headers.update({\n",
    "            \"user-agent\": \"Meijer/100900000 okhttp/4.12.0 Dalvik/2.1.0 (Linux; U; Android 10; One Build/QQ3A.200705.002)\",\n",
    "            \"ocp-apim-subscription-key\": self.API_KEY,\n",
    "            \"accept-encoding\": \"gzip\",\n",
    "        })\n",
    "        # Retain cookies from the environment\n",
    "        self.cookies.update(requests.utils.cookiejar_from_dict(dict(os.environ)))\n",
    "\n",
    "    def get_stores(self, latitude, longitude, miles=100, num_to_return=10, data_variant=2):\n",
    "        \"\"\"Fetches store information based on proximity.\"\"\"\n",
    "        url = f\"{self.BASE_URL}/digital/storeInfo/v2/stores/proximity\"\n",
    "        params = {\n",
    "            \"latitude\": latitude,\n",
    "            \"longitude\": longitude,\n",
    "            \"miles\": miles,\n",
    "            \"numToReturn\": num_to_return,\n",
    "            \"dataVariant\": data_variant,\n",
    "        }\n",
    "        headers = {\n",
    "            \"accept\": \"application/json\",\n",
    "            \"version\": \"9\",\n",
    "            \"content-type\": \"application/json\",\n",
    "        }\n",
    "        \n",
    "        response = self.get(url, headers=headers, params=params)\n",
    "        return response.json() if response.ok else response.text\n",
    "\n",
    "    def register(self, first_name, last_name, zip_code, store_id, email, password, phone_number, pin, enroll_in_pharmacy=True):\n",
    "        \"\"\"Registers a new user account with Meijer MPerks.\"\"\"\n",
    "        url = f\"{self.BASE_URL}/loyalty/accounts/createAccountWithMperks\"\n",
    "        headers = {\n",
    "            \"accept\": \"application/vnd.meijer.account.updateConfirmation-v1.0+json\",\n",
    "            \"content-type\": \"application/vnd.meijer.account.account-v1.0+json\",\n",
    "        }\n",
    "        payload = {\n",
    "            \"firstName\": first_name,\n",
    "            \"lastName\": last_name,\n",
    "            \"zip\": zip_code,\n",
    "            \"storeId\": store_id,\n",
    "            \"email\": email,\n",
    "            \"password\": password,\n",
    "            \"phoneNumber\": phone_number,\n",
    "            \"pin\": pin,\n",
    "            \"enrollInPharmacy\": enroll_in_pharmacy,\n",
    "        }\n",
    "        \n",
    "        response = self.post(url, headers=headers, json=payload)\n",
    "        return response.json() if response.ok else response.text"
   ]
