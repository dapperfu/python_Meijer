    "mid = os.environ[\"MEIJER_ID\"]\n",
    "request = dict()\n",
    "request[\"url\"] = (\n",
    "    \"https://mservices.meijer.com/dgtlmma/accounts/getAccount?id={}\".format(mid)\n",
    ")\n",
    "request[\"headers\"] = {\n",
    "    \"Accept\": \"application/vnd.meijer.account.account-v1.0+json\",\n",
    "    \"Authorization\": \"Bearer {}\".format(bearer_token),\n",
