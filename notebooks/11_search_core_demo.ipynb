    "## 🚀 Complete Search Workflow\n",
    "\n",
    "Demonstrate the complete search workflow using **core functionality**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def complete_search_workflow_core(search_term: str = \"lego jurassic\"):\n",
    "    \"\"\"Complete search workflow demonstration using core functionality.\"\"\"\n",
    "    \n",
    "    workflow_results = {\n",
    "        \"search_term\": search_term,\n",
    "        \"timestamp\": \"2024-01-01T00:00:00\",\n",
    "        \"steps\": {}\n",
    "    }\n",
    "    \n",
    "    print(f\"🚀 Starting complete search workflow for: '{search_term}'\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    # Step 1: Autocomplete using core method\n",
    "    print(\"\\n1️⃣  Step 1: Autocomplete Suggestions\")\n",
    "    autocomplete = client.search.autocomplete(search_term.split()[0], limit=5)\n",
    "    workflow_results[\"steps\"][\"autocomplete\"] = autocomplete\n",
    "    if autocomplete:\n",
    "        print(f\"✅ Autocomplete successful - {len(autocomplete)} suggestions\")\n",
    "    else:\n",
    "        print(\"❌ Autocomplete failed\")\n",
    "    \n",
    "    # Step 2: Main Search using core method\n",
    "    print(\"\\n2️⃣  Step 2: Main Search\")\n",
    "    search = client.search.search(search_term, page=1, results_per_page=10)\n",
    "    workflow_results[\"steps\"][\"main_search\"] = search\n",
    "    if search and search.has_results:\n",
    "        print(f\"✅ Search successful - Found {search.total_results} results\")\n",
    "        print(f\"   Current page: {search.current_page} of {search.total_pages}\")\n",
    "    else:\n",
    "        print(\"❌ Search failed\")\n",
    "    \n",
    "    # Step 3: Product Click Tracking using core method\n",
    "    print(\"\\n3️⃣  Step 3: Product Click Tracking\")\n",
    "    product_name = \"LEGO Jurassic World T. rex River Escape 76975\"\n",
    "    click_tracking = client.search.track_product_click(product_name)\n",
    "    workflow_results[\"steps\"][\"click_tracking\"] = click_tracking\n",
    "    if click_tracking:\n",
    "        print(\"✅ Click tracking successful\")\n",
    "    else:\n",
    "        print(\"❌ Click tracking failed\")\n",
    "    \n",
    "    # Step 4: Behavior Analytics using core method\n",
    "    print(\"\\n4️⃣  Step 4: Behavior Analytics\")\n",
    "    behavior = client.search.track_search_behavior(search_term, 239)\n",
    "    workflow_results[\"steps\"][\"behavior_analytics\"] = behavior\n",
    "    print(\"✅ Behavior tracking completed\")\n",
    "    \n",
    "    # Step 5: Additional Data using core methods\n",
    "    print(\"\\n5️⃣  Step 5: Additional Data Sources\")\n",
    "    \n",
    "    # Sponsored products\n",
    "    sponsored = client.search.get_sponsored_products(search_term.split()[0])\n",
    "    workflow_results[\"steps\"][\"sponsored_products\"] = sponsored\n",
    "    \n",
    "    # Promotions\n",
    "    promotions = client.search.get_complex_promotions()\n",
    "    workflow_results[\"steps\"][\"promotions\"] = promotions\n",
    "    \n",
    "    # Images\n",
    "    images = client.search.get_product_images(\"sample\")\n",
    "    workflow_results[\"steps\"][\"product_images\"] = images\n",
    "    \n",
    "    print(\"✅ Additional data sources accessed\")\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"🎉 Complete search workflow finished!\")\n",
    "    \n",
    "    return workflow_results\n",
    "\n",
    "# Run complete workflow using core functionality\n",
    "workflow_results = complete_search_workflow_core(\"lego jurassic\")\n",
    "\n",
    "print(\"\\n📊 Workflow Summary:\")\n",
    "print(f\"🔍 Search Term: {workflow_results['search_term']}\")\n",
    "print(f\"⏰ Timestamp: {workflow_results['timestamp']}\")\n",
    "print(f\"📋 Steps Completed: {len(workflow_results['steps'])}\")\n",
    "print(f\"✅ Successful Steps: {sum(1 for step in workflow_results['steps'].values() if step)}")
   ]
  },
