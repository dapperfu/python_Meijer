   "source": [
    "# Get a larger search result to demonstrate advanced features\n",
    "print(\"🔍 Getting larger search result for advanced features...\")\n",
    "advanced_search = client.search.search(\"lego\", page=1, results_per_page=20)\n",
    "\n",
    "if advanced_search and advanced_search.has_results:\n",
    "    print(f\"✅ Found {advanced_search.total_results} results\")\n",
    "    \n",
    "    # Demonstrate filtering\n",
    "    print(\"\\n🔍 Filtering results...\")\n",
    "    \n",
    "    # Filter by price range\n",
    "    price_filtered = advanced_search.filter_by_price_range(min_price=10.0, max_price=50.0)\n",
    "    print(f\"💰 Price range $10-$50: {len(price_filtered.results)} results\")\n",
    "    \n",
    "    # Filter on sale items\n",
    "    sale_items = advanced_search.filter_on_sale()\n",
    "    print(f\"🏷️  On sale: {len(sale_items.results)} results\")\n",
    "    \n",
    "    # Filter in-stock items\n",
    "    in_stock = advanced_search.filter_in_stock()\n",
    "    print(f\"📦 In stock: {len(in_stock.results)} results\")\n",
    "    \n",
    "    # Sort by price\n",
    "    price_sorted = advanced_search.sort_by_price(ascending=True)\n",
    "    print(f\"📊 Sorted by price (low to high)\")\n",
    "    \n",
    "    # Get statistics\n",
    "    stats = advanced_search.get_statistics()\n",
    "    print(f\"\\n📈 Search Statistics:\")\n",
    "    print(f\"  Total results: {stats['total_results']}\")\n",
    "    print(f\"  Current page results: {stats['current_page_results']}\")\n",
    "    print(f\"  Total pages: {stats['total_pages']}\")\n",
    "    \n",
    "    if 'price_stats' in stats:\n",
    "        print(f\"  Price range: ${stats['price_stats']['min_price']:.2f} - ${stats['price_stats']['max_price']:.2f}\")\n",
    "        print(f\"  Average price: ${stats['price_stats']['avg_price']:.2f}\")\n",
    "    \n",
    "    if 'availability_stats' in stats:\n",
    "        print(f\"  In stock: {stats['availability_stats']['in_stock']}\")\n",
    "        print(f\"  On sale: {stats['availability_stats']['on_sale']}\")\n",
    "else:\n",
    "    print(\"❌ No search results for advanced features\")"
